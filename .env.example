# ReceiptIQ environment variables. Copy to .env.local for local dev.
# The app runs correctly with ALL of these unset:
#   - no GEMINI_API_KEY  -> AI OCR returns 501 and the app falls back to Tesseract.js
#   - no site URL        -> metadataBase falls back to http://localhost:3000

# --- AI OCR (optional) ---------------------------------------------------------
# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Override the vision model if you like (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# --- Site metadata (optional) ------------------------------------------------
# Canonical/OG absolute URL. On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used
# automatically if this is unset.
NEXT_PUBLIC_SITE_URL=

# Link target for the "GitHub" nav/footer links.
NEXT_PUBLIC_REPO_URL=

# --- Price database (NOT needed at current scale) ---------------------------
# The ~350-entry catalog is served from data/price-db.json. Only set these if
# you migrate to a database (see README "Price data — JSON vs database").
# DATABASE_URL=
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
